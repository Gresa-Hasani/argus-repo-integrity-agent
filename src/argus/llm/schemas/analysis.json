{
  "$defs": {
    "AnomalyResolution": {
      "properties": {
        "anomaly_id": {
          "title": "Anomaly Id",
          "type": "string"
        },
        "explanation": {
          "minLength": 20,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "anomaly_id",
        "explanation"
      ],
      "title": "AnomalyResolution",
      "type": "object"
    },
    "Category": {
      "enum": [
        "REPOSITORY_ACCESS",
        "COMMIT_INTEGRITY",
        "CONTRIBUTION_INTEGRITY",
        "COAUTHOR_INTEGRITY",
        "LOC_INFLATION",
        "COMMIT_INFLATION",
        "CODE_PROVENANCE",
        "SIMILARITY",
        "AI_ASSISTANCE",
        "BRANCH_WORKFLOW",
        "CI_CD",
        "REPOSITORY_HYGIENE",
        "SECRET_EXPOSURE",
        "README_MISMATCH",
        "TIMELINE_ANOMALY",
        "EVALUATOR_ERROR"
      ],
      "title": "Category",
      "type": "string"
    },
    "LLMFinding": {
      "properties": {
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "finding": {
          "minLength": 3,
          "title": "Finding",
          "type": "string"
        },
        "reasoning": {
          "minLength": 3,
          "title": "Reasoning",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "requires_manual_review": {
          "default": false,
          "title": "Requires Manual Review",
          "type": "boolean"
        },
        "possible_explanations": {
          "items": {
            "type": "string"
          },
          "title": "Possible Explanations",
          "type": "array"
        }
      },
      "required": [
        "title",
        "category",
        "severity",
        "finding",
        "reasoning",
        "evidence_ids",
        "confidence"
      ],
      "title": "LLMFinding",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "description": "Structured output of one specialised reasoning step.",
  "properties": {
    "summary": {
      "minLength": 3,
      "title": "Summary",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/LLMFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "resolved_anomalies": {
      "items": {
        "$ref": "#/$defs/AnomalyResolution"
      },
      "title": "Resolved Anomalies",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "classification": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Classification"
    }
  },
  "required": [
    "summary"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
