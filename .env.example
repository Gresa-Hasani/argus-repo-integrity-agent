# Reference only: ARGUS does NOT load .env automatically.
# Export variables in the backend shell, or use a process launcher with env-file support.
# Never commit real API keys. Never put them in NEXT_PUBLIC_* frontend variables.

# Server/CLI default: qwen | ollama | openai | anthropic (alias claude)
ARGUS_LLM_PROVIDER=qwen
ARGUS_MODEL=qwen3:4b
# Optional local fallback; always disclosed in reports when used.
# ARGUS_FALLBACK_MODEL=

# LOCAL transports. When switching to a hosted provider, remove these local settings
# or replace the base URL with the intended HTTPS API endpoint.
ARGUS_LLM_BACKEND=ollama
ARGUS_LLM_BASE_URL=http://localhost:11434
ARGUS_LLM_TEMPERATURE=0.1
ARGUS_LLM_MAX_TOKENS=1536
ARGUS_LLM_NUM_CTX=8192
ARGUS_LLM_PACKET_CHARS=9000
ARGUS_LLM_TIMEOUT=900
ARGUS_LLM_THINK=false
# ARGUS_LLM_MODEL_TAG=
# ARGUS_LLM_FALLBACK_MODEL_TAG=

# Explicit hosted UI choices (backend environment only).
# OPENAI_API_KEY=
# ARGUS_OPENAI_MODEL=gpt-4.1-mini
# ARGUS_OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ARGUS_ANTHROPIC_MODEL=claude-sonnet-4-6
# ARGUS_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ARGUS_LLM_API_KEY=  # generic key fallback

# Evidence, storage and local server.
# GITHUB_TOKEN=  # or GH_TOKEN; optional GitHub API authentication
# ARGUS_SCC_PATH=
ARGUS_SIMILARITY_THRESHOLD=0.70
ARGUS_REPORTS_DIR=argus-reports
# ARGUS_ALLOWED_ORIGINS=http://localhost:3001
# HOST=127.0.0.1
# PORT=8000
