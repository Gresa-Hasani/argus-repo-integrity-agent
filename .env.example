# Copy to .env (never commit .env). All values are optional; defaults shown.
ARGUS_LLM_PROVIDER=qwen
# Model served by the local runtime: qwen3:4b (default, fits free hosting) or qwen3:8b
ARGUS_MODEL=qwen3:4b
# Optional, off by default. Whenever a fallback is used the report says so.
# ARGUS_FALLBACK_MODEL=
# Local web API: extra browser origins allowed to call it (localhost:3000 is always allowed)
# ARGUS_ALLOWED_ORIGINS=http://localhost:3001
# HOST=127.0.0.1
# PORT=8000
# ollama | openai  (openai = any OpenAI-compatible local server: vLLM, llama.cpp, LM Studio)
ARGUS_LLM_BACKEND=ollama
ARGUS_LLM_BASE_URL=http://localhost:11434
ARGUS_LLM_TEMPERATURE=0.1
ARGUS_LLM_MAX_TOKENS=1536
ARGUS_LLM_NUM_CTX=8192
# Size of the evidence packet sent per reasoning step. Raise it on GPU hardware.
ARGUS_LLM_PACKET_CHARS=9000
ARGUS_LLM_TIMEOUT=900
ARGUS_LLM_THINK=false
# Optional: map a logical model name to the tag your runtime uses.
# ARGUS_LLM_MODEL_TAG=qwen3:8b
# ARGUS_LLM_FALLBACK_MODEL_TAG=hf.co/ggml-org/Qwen3-4B-GGUF:Q4_K_M
# Optional: raises the GitHub API rate limit. Read from the environment only.
# GITHUB_TOKEN=
# Optional: path to the Boyter scc binary if it is not on PATH.
# ARGUS_SCC_PATH=
